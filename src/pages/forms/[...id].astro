---
import FormField from '@/components/FormField.astro'
import { FORM_POST_URL } from '@/consts'
import Layout from '@/layouts/Layout.astro'
import { getAllForms } from '@/lib/data-utils'
import { formatDate } from '@/lib/utils'
import { Icon } from 'astro-icon/components'
import { render } from 'astro:content'

export async function getStaticPaths() {
  const forms = await getAllForms()
  return forms.map((form) => ({
    params: { id: form.id },
    props: form,
  }))
}

const { Content } = await render(Astro.props)
const form = Astro.props.data
const fields = Astro.props.data.form.fields

// Group consecutive fields sharing the same show_if into one fieldset.
type Segment = {
  sig: string | null
  showField?: string
  values?: string[]
  legend?: string
  fields: typeof fields
}
const segments: Segment[] = []
for (const field of fields) {
  const show = field.show_if
  const values = show
    ? Array.isArray(show.equals)
      ? show.equals
      : [show.equals]
    : undefined
  const sig = show ? JSON.stringify([show.field, values]) : null
  const prev = segments[segments.length - 1]
  if (prev && prev.sig === sig) {
    prev.fields.push(field)
  } else {
    segments.push({
      sig,
      showField: show?.field,
      values,
      legend: values?.join(' / '),
      fields: [field],
    })
  }
}
---

<Layout>
  <section
    class="border-border mx-auto flex w-full max-w-3xl flex-col items-center gap-y-2 rounded-xl border p-8"
  >
    <h1
      class="mb-2 w-full scroll-mt-31 text-center text-3xl leading-tight font-medium sm:text-4xl"
    >
      {form.title}
    </h1>
    <div
      class="text-muted-foreground mb-6 flex w-fit py-2 text-xs sm:px-2 sm:py-0 sm:text-sm"
    >
      <span>{formatDate(form.date)}</span>
    </div>

    <article class="prose w-full">
      <p>{form.description}</p>
      <Content />
    </article>

    <form
      action={`${FORM_POST_URL}${form.id}`}
      data-form-id={form.id}
      method="POST"
      enctype="multipart/form-data"
      class="flex w-full flex-col items-start gap-12"
    >
      <input type="hidden" name="submit_token" id="submit-token" />
      {
        segments.map((seg) =>
          seg.showField ? (
            <fieldset
              data-show-field={seg.showField}
              data-show-equals={JSON.stringify(seg.values)}
              hidden
              disabled
              class="w-full"
            >
              <legend class="text-muted-foreground pb-2 pl-1">
                {seg.legend}
              </legend>
              <div class="flex w-full flex-col items-start gap-12">
                {seg.fields.map((field) => (
                  <FormField field={field} />
                ))}
              </div>
            </fieldset>
          ) : (
            seg.fields.map((field) => <FormField field={field} />)
          ),
        )
      }
      <div
        class="ml-auto grid w-full grid-cols-2 items-center justify-end gap-4 md:w-auto md:grid-cols-3"
      >
        <span
          id="save-indicator"
          class="text-muted-foreground ext-sm col-span-2 flex items-center justify-center gap-2 opacity-0 transition-opacity duration-300 md:col-span-1"
        >
          <Icon name="lucide:check" class="text-primary" />
          Draft autosaved
        </span>

        <!-- Click again to confirm clear.  -->
        <button
          type="button"
          onclick="if(this.textContent==='Confirm?') { this.form.reset(); this.textContent='Clear'; this.classList.replace('bg-destructive', 'bg-muted'); } else { this.textContent='Confirm?'; this.classList.replace('bg-muted', 'bg-destructive'); this.classList.add('text-destructive-foreground'); }"
          onblur="this.textContent='Clear'; this.classList.replace('bg-destructive', 'bg-muted'); this.classList.remove('text-destructive-foreground');"
          class="bg-muted text-foreground rounded-lg px-4 py-2 font-sans text-lg font-bold transition-all duration-200"
        >
          Clear
        </button>
        <button
          type="submit"
          class="bg-primary text-primary-foreground rounded-lg px-4 py-2 font-sans text-lg font-bold"
        >
          {form.submit_text || 'Submit'}
        </button>
      </div>
    </form>
  </section>

  <script>
    const setupAutosave = () => {
      const form = document.querySelector<HTMLFormElement>('form[data-form-id]')
      const indicator = document.getElementById('save-indicator')
      // DOMContentLoaded and astro:page-load both fire on initial load; a
      // second run would double listeners and stack action suffixes
      if (!form || form.dataset.setup === '1') return
      form.dataset.setup = '1'

      const storageKey = `autosave-form-${form.dataset.formId}`
      const baseAction = form.action

      // show_if: defined and registered before any storage work so field
      // visibility survives autosave failures (eg. crypto.randomUUID is
      // missing on insecure LAN origins). Disabled fieldsets are skipped by
      // validation and the POST payload. ponytail: checkbox-group gating
      // unsupported — use radio or select as the controlling field.
      const applyShowIf = () => {
        form
          .querySelectorAll<HTMLFieldSetElement>('fieldset[data-show-field]')
          .forEach((fs) => {
            const values = JSON.parse(fs.dataset.showEquals || '[]')
            const control = form.elements.namedItem(fs.dataset.showField!)
            const value = (control as HTMLInputElement | undefined)?.value ?? ''
            const match = values.includes(value)
            fs.hidden = !match
            fs.disabled = !match
          })

        // backend keeps a separate schema per subpanel:
        // {form_id}_{subpanel}; forms without a 'subpanel' field are untouched
        const subpanel = form.elements.namedItem(
          'subpanel',
        ) as HTMLSelectElement | null
        if (subpanel?.value) {
          form.action = `${baseAction}_${subpanel.value.replace(/\s+/g, '_')}`
        }
      }

      const saveDraft = () => {
        const formData = new FormData(form)
        const data: Record<string, any> = {}

        for (const [key, value] of formData.entries()) {
          if (value instanceof File) continue
          if (data[key]) {
            data[key] = [].concat(data[key], value as any)
          } else {
            data[key] = value
          }
        }

        localStorage.setItem(storageKey, JSON.stringify(data))
        if (indicator) indicator.classList.remove('opacity-0')
      }

      applyShowIf()
      // save runs before show_if so the snapshot still includes fields this
      // change is about to disable
      form.addEventListener('input', saveDraft)
      form.addEventListener('input', applyShowIf)

      // Idempotency token: one per visitor session. Survives a refresh while
      // filling out, so a retry or back-navigation resubmit won't duplicate.
      const tokenKey = `submit-token-${form.dataset.formId}`
      const token =
        sessionStorage.getItem(tokenKey) ||
        (typeof crypto.randomUUID === 'function'
          ? crypto.randomUUID()
          : // ponytail: randomUUID is secure-context-only; http://LAN origins
            // get a weaker but unique-enough token
            `${Date.now().toString(36)}-${Math.random().toString(36).slice(2)}`)
      sessionStorage.setItem(tokenKey, token)
      const tokenInput = document.getElementById(
        'submit-token',
      ) as HTMLInputElement | null
      if (tokenInput) tokenInput.value = token

      // Guard against double-click / submit retries.
      const submitBtn = form.querySelector<HTMLButtonElement>('[type="submit"]')
      form.addEventListener('submit', () => {
        if (submitBtn) {
          submitBtn.disabled = true
          submitBtn.textContent = 'Submitting…'
        }
      })

      // load saved data on mount
      const savedData = JSON.parse(localStorage.getItem(storageKey) || '{}')

      Object.entries(savedData).forEach(([name, value]) => {
        const inputs = form.querySelectorAll(`[name="${name}"]`)
        inputs.forEach((input: any) => {
          if (input.type === 'file') return
          if (input.type === 'checkbox' || input.type === 'radio') {
            input.checked = Array.isArray(value)
              ? value.includes(input.value)
              : input.value === value
          } else {
            input.value = value
          }
        })
      })

      // re-gate: the restored draft may have picked a different subpanel
      applyShowIf()

      // clear localStorage on submit
      form.addEventListener('submit', () => {
        localStorage.removeItem(storageKey)
      })
    }

    document.addEventListener('DOMContentLoaded', setupAutosave)
    document.addEventListener('astro:page-load', setupAutosave)
  </script>
</Layout>
